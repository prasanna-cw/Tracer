{
  "name": "tracer-code-flow",
  "displayName": "Tracer: Code Flow & Map",
  "description": "Trace your code: flow diagrams of files and functions, and a map and graph of the whole workspace. Runs locally: no network, no telemetry.",
  "version": "0.0.4",
  "publisher": "PrasannaMurugan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prasanna-cw/Tracer.git"
  },
  "bugs": {
    "url": "https://github.com/prasanna-cw/Tracer/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:tracer.openGraph",
    "onCommand:tracer.openDiagram",
    "onView:tracer.home",
    "onCustomEditor:tracer.flowEditor",
    "onCommand:tracer.showFlow",
    "onCommand:tracer.showFunctionFlow",
    "onCommand:tracer.traceCalls",
    "onCommand:tracer.openMap"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tracer",
          "title": "Tracer",
          "icon": "media/tracer.svg"
        }
      ]
    },
    "views": {
      "tracer": [
        {
          "id": "tracer.home",
          "name": "Workspace",
          "icon": "media/tracer.svg",
          "contextualTitle": "Tracer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tracer.home",
        "contents": "Open a folder to trace its code.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "tracer.openMap",
        "title": "Open Map",
        "category": "Tracer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tracer.openGraph",
        "title": "Open Graph",
        "category": "Tracer",
        "icon": "$(graph)"
      },
      {
        "command": "tracer.openDiagram",
        "title": "Open Saved Flow…",
        "category": "Tracer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tracer.refresh",
        "title": "Refresh",
        "category": "Tracer",
        "icon": "$(refresh)"
      },
      {
        "command": "tracer.showFlow",
        "title": "Show Flow",
        "category": "Tracer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tracer.showFunctionFlow",
        "title": "Show Flow of This Function",
        "category": "Tracer",
        "icon": "$(symbol-method)"
      },
      {
        "command": "tracer.traceCalls",
        "title": "Trace Calls From This Function",
        "category": "Tracer",
        "icon": "$(references)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tracer.refresh",
          "when": "view == tracer.home",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tracer.refresh",
          "when": "false"
        },
        {
          "command": "tracer.showFlow",
          "when": "editorIsOpen"
        },
        {
          "command": "tracer.showFunctionFlow",
          "when": "editorIsOpen"
        },
        {
          "command": "tracer.traceCalls",
          "when": "editorIsOpen"
        }
      ],
      "explorer/context": [
        {
          "command": "tracer.openMap",
          "when": "explorerResourceIsFolder",
          "group": "navigation@89"
        },
        {
          "command": "tracer.openGraph",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        },
        {
          "command": "tracer.showFlow",
          "when": "resourceExtname =~ /^\\.(c|cc|cjs|cpp|cs|cts|cxx|dart|ex|exs|go|h|hh|hpp|hxx|java|js|jsx|kt|kts|lua|mjs|mts|php|py|pyi|rb|rs|sc|scala|swift|ts|tsx|zig)$/i && !explorerResourceIsFolder",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "submenu": "tracer.editorMenu",
          "when": "resourceExtname =~ /^\\.(c|cc|cjs|cpp|cs|cts|cxx|dart|ex|exs|go|h|hh|hpp|hxx|java|js|jsx|kt|kts|lua|mjs|mts|php|py|pyi|rb|rs|sc|scala|swift|ts|tsx|zig)$/i",
          "group": "navigation@90"
        }
      ],
      "tracer.editorMenu": [
        {
          "command": "tracer.showFlow",
          "group": "1_flow@1"
        },
        {
          "command": "tracer.showFunctionFlow",
          "group": "1_flow@2"
        },
        {
          "command": "tracer.traceCalls",
          "group": "1_flow@3"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tracer.flowEditor",
        "displayName": "Tracer Flow",
        "selector": [
          {
            "filenamePattern": "*.diagram.json"
          },
          {
            "filenamePattern": "*.canvas"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Tracer",
      "properties": {
        "tracer.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Match VS Code: its colors, light or dark.",
            "Always Tracer's light theme.",
            "Always Tracer's dark theme."
          ],
          "default": "auto",
          "description": "Theme of Tracer's flow and graph views."
        },
        "tracer.flow.traceDepth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "How many calls deep \"Trace Calls From This Function\" follows."
        }
      }
    },
    "submenus": [
      {
        "id": "tracer.editorMenu",
        "label": "Tracer"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "package": "npm run build && vsce package --no-dependencies --out tracer.vsix",
    "test:vscode": "npm run build && tsx test/e2e/runTests.ts"
  },
  "dependencies": {
    "@tracer/cli": "*",
    "@tracer/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b2470",
    "theme": "dark"
  },
  "keywords": [
    "flow",
    "flowchart",
    "control flow",
    "diagram",
    "call graph",
    "call trace",
    "dependency graph",
    "architecture",
    "code map",
    "imports",
    "visualization",
    "microservices",
    "java",
    "python",
    "typescript",
    "go",
    "csharp",
    "kotlin",
    "rust",
    "php",
    "ruby",
    "code understanding",
    "tracer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Tracer reads source files from disk."
    }
  }
}
