	"codemap":{
		"version":1,
		"title":"Saving a risk assessment",
		"steps":[
			{
				"id":"s1",
				"title":"User clicks Save",
				"description":"The whole risk register is submitted in one request.",
				"nodeIds":["start"]
			},
			{
				"id":"s2",
				"title":"Form input",
				"description":"Each row is a risk with cell values, **tags** and **actions**.",
				"nodeIds":["input"],
				"edgeIds":["e-start-input"]
			},
			{
				"id":"s3",
				"title":"Controller",
				"description":"`saveRiskAssessment()` only validates and delegates.",
				"nodeIds":["controller"],
				"edgeIds":["e-input-ctrl"]
			},
			{
				"id":"s4",
				"title":"Service transaction",
				"description":"One transaction. Existing data is read **before** the loop, never inside it.",
				"nodeIds":["service"],
				"edgeIds":["e-ctrl-svc"]
			},
			{
				"id":"s5",
				"title":"Entities per risk",
				"description":"For each risk the service builds four kinds of entity and calls `saveAll()` per collection.",
				"nodeIds":["ent-record","ent-cells","ent-tags","ent-actions"],
				"edgeIds":["e-svc-record","e-svc-cells","e-svc-tags","e-svc-actions"]
			},
			{
				"id":"s6",
				"title":"Flush once per risk",
				"description":"Queued inserts are sent together when the record is flushed.",
				"nodeIds":["flush"],
				"edgeIds":["e-record-flush","e-cells-flush","e-tags-flush","e-actions-flush"]
			},
			{
				"id":"s7",
				"title":"Batched writes",
				"description":"Each flush becomes one JDBC batch per table: two risks, two batches.",
				"nodeIds":["db-group","tbl-record","tbl-cells","tbl-tags","tbl-actions"],
				"edgeIds":["e-flush-record","e-flush-cells","e-flush-tags","e-flush-actions"]
			},
			{
				"id":"s8",
				"title":"Deletes after the loop",
				"description":"Removed children are deleted in one statement per table.",
				"nodeIds":["note-deletes"],
				"edgeIds":["e-db-deletes"]
			},
			{
				"id":"s9",
				"title":"Result and config",
				"description":"Batching only works with the right Hibernate settings and SEQUENCE ids.",
				"nodeIds":["note-batching"],
				"edgeIds":["e-db-batching"]
			}
		]
	}
