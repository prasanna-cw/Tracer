		{
			"id": "controller",
			"type": "text",
			"x": 320,
			"y": 350,
			"width": 480,
			"height": 110,
			"text": "## Controller\n\n*RiskController.saveRiskAssessment()*\n\nThin: validates the request DTO and calls the service. No persistence logic.",
			"color": "6",
			"codemap": {
				"kind": "layer",
				"title": "Controller",
				"subtitle": "RiskController.saveRiskAssessment()",
				"category": "layer",
				"source": {
					"path": "src/main/java/app/risk/RiskController.java",
					"line": 42
				},
				"text": "Thin: validates the request DTO and calls the service. No persistence logic.",
				"textHash": "d5bc53d8",
				"derivedColor": true
			}
		},
		{
			"id": "service",
			"type": "text",
			"x": 320,
			"y": 520,
			"width": 480,
			"height": 180,
			"text": "## Service layer\n\n*RiskService.save() · @Transactional*\n\n- One transaction for the whole save\n- Load existing records, tags and actions once, before the loop\n- Per risk: saveAll() for each child collection\n- One flush per risk record",
			"color": "4",
			"codemap": {
				"kind": "layer",
				"title": "Service layer",
				"subtitle": "RiskService.save() · @Transactional",
				"category": "service",
				"rows": [
					{
						"text": "One transaction for the whole save"
					},
					{
						"text": "Load existing records, tags and actions once, before the loop"
					},
					{
						"text": "Per risk: saveAll() for each child collection"
					},
					{
						"text": "One flush per risk record"
					}
				],
				"source": {
					"path": "src/main/java/app/risk/RiskService.java",
					"line": 88
				},
				"text": null,
				"textHash": "2a793bea",
				"derivedColor": true
			}
		},
